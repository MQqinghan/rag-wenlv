/* 全局样式（与 Web 端 chat.html 的浅色基调保持一致） */
page {
  background: #f6f7f9;
  color: #1f2329;
  font-size: 30rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #2f6fed;
  color: #ffffff;
  border-radius: 12rpx;
}

.btn-plain {
  background: #eef1f6;
  color: #1f2329;
  border-radius: 12rpx;
}
