# =============================================================================
# 导入侧独立部署环境模板（A1 · .env.import.example）
# -----------------------------------------------------------------------------
# 用途：导入进程（import_server，端口 8000）单独部署时，复制本文件为 .env 使用。
#       （查询侧只需共享底座，见 .env 总表「一、共享底座」；不部署本文件。）
# 安全：所有 Key 均为占位符，请勿提交真实密钥。
# 外发开关：IMPORT_EGRESS_MODE=off 时，VL/元数据 LLM/MinerU 等外发全部被
#       跳过或报错（A2 egress_gateway 收口后统一生效）；此时下方外发相关
#       Key 可留空，导入以「文件名规则」降级完成。
# =============================================================================

# ============================ 服务基础 ============================
IMPORT_APP_NAME=Enterprise RAG Import Service
IMPORT_APP_PORT=8000
APP_HOST=0.0.0.0
APP_ENV=dev

# ============================ 外发总开关（A1，必读） ============================
# off = 一键关停所有外发 | mask = 脱敏后外发（默认） | full = 原样外发
IMPORT_EGRESS_MODE=mask
# 供应商白名单（A2 网关校验，逗号分隔；不填用内置默认：dashscope.aliyuncs.com/open.bigmodel.cn/mineru.net）
# IMPORT_EGRESS_ALLOWED_HOSTS=dashscope.aliyuncs.com,open.bigmodel.cn
# 词典敏感词（A3 脱敏，逗号分隔：内部项目代号/重点人名；人名不做通用 NER）
# IMPORT_EGRESS_SENSITIVE_WORDS=绝密代号X,龙鳞计划
# 图片敏感预检（A3）：auto=本地 OCR 可用即启用（默认）/ on=强制（缺依赖会显式降级）/ off=关闭
IMAGE_SENSITIVE_GUARD=auto

# ============================ LLM / VL 凭证（外发出口） ============================
# 视觉理解（图片 OCR / Markdown 内嵌图）：OpenAI 兼容端点，必填
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your-key
VL_MODEL=qwen3-vl-flash
# 元数据抽取 LLM（若供应商为智谱则填 ZHIPU*；默认跟随 LLM_PROVIDER）
LLM_PROVIDER=zhipu
ZHIPUAI_API_KEY=your-zhipu-key
ZHIPUAI_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZP_MODEL=glm-4-flash-250414
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1

# ============================ 本地模型（embedding 入库，不外发） ============================
BGE_M3_PATH=./models/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
EMBEDDING_DIM=1024
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=./models/modelscope_cache
HF_HOME=./models/huggingface_cache

# ============================ 存储（向量库 / 会话任务 / 对象存储） ============================
MILVUS_URL=http://127.0.0.1:19530
MILVUS_DATABASE=new
TOURISM_CHUNKS_COLLECTION=tourism_chunks
TOURISM_ENTITY_COLLECTION=tourism_entity

MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb002

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=mydata
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ============================ 文档解析（外发出口，off 档可留空） ============================
# MinerU 云服务（PDF/复杂版式 → Markdown）；本地模型源时可不填
MINERU_MODEL_SOURCE=modelscope
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=your-mineru-token

# ============================ 导入目录与限制 ============================
MD_ROOT_DIR=./temp-files/
TABLE_MAX_ROWS=10000
CELL_MAX_LEN=2000

# ============================ 日志 ============================
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
