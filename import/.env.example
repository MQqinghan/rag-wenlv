# =========================
# 应用基础配置
# =========================
IMPORT_APP_NAME=Enterprise RAG Import Service
QUERY_APP_NAME=Enterprise RAG Query Service
APP_ENV=dev
APP_HOST=0.0.0.0
IMPORT_APP_PORT=8000
QUERY_APP_PORT=8001
CORS_ORIGINS=*

# =========================
# LLM / VL 模型配置
# 注意：
# 1. OPENAI_API_KEY 当前同时被普通 LLM 与 DashScope MCP 配置复用
# 2. LLM_DEFAULT_TEMPERATURE 必须可被转换为 float
# =========================
OPENAI_BASE_URL=https://your-llm-endpoint/v1
OPENAI_API_KEY=sk-your-key
LLM_DEFAULT_MODEL=qwen-plus
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=qwen-vl-max
# 意图路由开关（B1，2026-09-09 拍板默认 true=LLM 主导 v2）
# true：LLM 单次输出改写+数据源三档+工具+is_plan（产出 route_info）
# false：回退 v1 规则主导链路（仅单域标签），作旁路/回归对照用
INTENT_ROUTER_LLM_FIRST=true

# ==== 框架模块接线开关（2026-09-10 整合；均默认 OFF，OFF 时行为与接线前一致）====
# B1 新版意图路由（LLM 主导单次多路决策；翻 true 前需全量评测门禁）
INTENT_ROUTE_LLM_FIRST=false
# E 模型档位路由（按 route_info.model_tier 选模型）+ LLM 可靠性（超时/熔断/降级）
LLM_TIER_ROUTING=false
LLM_RELIABILITY=false
LLM_TIMEOUT_SECONDS=60
# F 长期记忆（按 user_id 持久化，跨会话）+ 长对话压缩
USER_MEMORY_ENABLED=false
CONTEXT_COMPRESSION_ENABLED=false
# I Action 风控闸门（工具执行前校验 action 授权）
ACTION_GUARD_ENABLED=false

# =========================
# Embedding 配置
# =========================
BGE_M3_PATH=./models/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False

# =========================
# Reranker 配置
# =========================
BGE_RERANKER_LARGE=./models/bge-reranker-v2-m3
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False

# =========================
# Milvus 配置
# =========================
MILVUS_URL=http://127.0.0.1:19530
TOURISM_CHUNKS_COLLECTION=tourism_chunks
TOURISM_ENTITY_COLLECTION=tourism_entity

# =========================
# Mongo 配置
# =========================
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=enterprise_rag

# =========================
# MinIO 配置
# endpoint 不带 http/https，由代码内部配合 secure 使用
# MINIO_IMG_DIR 建议以 / 开头，例如 /kb-images
# =========================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=enterprise-rag
MINIO_IMG_DIR=/kb-images
MINIO_SECURE=False

# =========================
# MinerU 配置
# =========================
MINERU_BASE_URL=https://your-mineru-endpoint
MINERU_API_TOKEN=your-mineru-token

# =========================
# 导入侧外发总开关（A1，导入进程必读）
# 语义：off=一键关停所有外发（ASR/VL 跳过或报错，元数据回落文件名规则，质量降级零泄露）
#      | mask=脱敏后外发（默认）| full=原样外发（仅已确认公开内容的批次）
# 导入侧独立部署模板见 .env.import.example
# =========================
IMPORT_EGRESS_MODE=mask

# =========================
# 导入侧外发脱敏 / 图片预检（A3，可选，不配置用默认）
# =========================
# 供应商白名单（逗号分隔；不填用内置默认 dashscope.aliyuncs.com/open.bigmodel.cn/mineru.net）
# IMPORT_EGRESS_ALLOWED_HOSTS=dashscope.aliyuncs.com,open.bigmodel.cn
# 词典敏感词（内部项目代号/重点人名；人名不做通用 NER）
# IMPORT_EGRESS_SENSITIVE_WORDS=
# 图片敏感预检：auto=本地OCR可用即启用（默认）/ on=强制 / off=关闭
IMAGE_SENSITIVE_GUARD=auto

# =========================
# DashScope MCP / WebSearch 配置
# 当前 node_web_search_mcp 固定走 DashScope WebSearch MCP
# MCP_DASHSCOPE_BASE_URL 当前代码未实际使用，但建议仍保留
# =========================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# =========================
# 项目根目录可选配置
# 如果未设置，代码会自动递归查找 .env
# =========================
PROJECT_ROOT=

# =========================
# 高德地图 + 行程规划（结构化 JSON 行程 / route_tool 共用）
# =========================
# Web服务(服务端) Key：POI 搜索/天气/地理编码/路线，与 trip_plan 高德核查共用
AMAP_API_KEY=
# 高德请求超时（秒）
AMAP_TIMEOUT=6
# =========================
# 景点 POI 工具（T15-D1，仅行程分支 is_plan）：高德 POI 结构化信息 + 景点间距离
# =========================
POI_TOOL_ENABLE=True
POI_TOOL_MAX_ITEMS=6
POI_TOOL_DISTANCE_ENABLE=True
# 召回关键词（|分隔，多词合并去重）。实测单个"景点"召回的是商务楼/园区，须用下列景区类词
POI_SEARCH_KEYWORDS=旅游景区|热门景点|名胜古迹
# 网络/HTTP 异常重试次数（不含首次请求，默认 1 = 最多 2 次尝试）
AMAP_RETRY_TIMES=1
# --- 限流治理（2026-09-09 新增，行程规划 POI 核查并发化前置）---
# 进程级最小请求间隔（毫秒），换算 QPS 上限；默认 250 ≈ 4 QPS（高德个人 Key 并发常为 3~5）。设 0 关闭节流
AMAP_MIN_INTERVAL_MS=250
# 命中限流（CUQPS_HAS_EXCEEDED_THE_LIMIT 等）后的额外退避重试次数，与网络异常额度独立
AMAP_RATE_LIMIT_RETRIES=3
# 退避基数（毫秒）：实际等待 = base * 2^次数 + 抖动，上限 3 秒
AMAP_BACKOFF_BASE_MS=400
# 行程规划 POI 核查并发度（C1 主体）：并发线程数，受上面节流器统一限速，默认 4
TRIP_VERIFY_WORKERS=4
# 偏好关键词采集并发度（C2，2026-09-09）：多偏好关键词并行搜索线程数，默认 4
TRIP_COLLECT_POIS_WORKERS=4
# 每日景点下限（C1-fix，2026-09-09）：核查后当日不足自动用高德真实 POI 补齐，默认 2
TRIP_MIN_ATTRS_PER_DAY=2
# 补位候选池大小（M6+方案A，2026-09-09）：只取高德"热门"前几名补位，宁缺毋滥不取冷门，默认 6
TRIP_TOPUP_POI_OFFSET=6
# 前端地图 Web端(JS API) Key 与安全密钥（trip.html 渲染地图用，未配置则仅展示行程列表）
# TRIP_AMAP_JS_KEY=
# AMAP_JS_SECURITY_CODE=

# =========================
# 天气工具（对话流与行程规划共用；统一由 app/infra/weather_gateway 收口）
# =========================
QWEATHER_API_KEY=
QWEATHER_API_HOST=https://api.qweather.com
TOOL_WEATHER_DAYS=5
# 天气总开关（关闭后网关直接返回空简报，不发起任何请求）
TOOL_WEATHER_ENABLE=True
TOOL_WEATHER_TIMEOUT=6
# 主数据源：qweather（默认，3~30 天 + 降水量）/ amap（硬上限 4 天、无降水量）
WEATHER_PRIMARY=qweather
# 主源失败（超时/额度耗尽/Key 失效）时是否自动降级到备源
WEATHER_FALLBACK=true

# =========================
# 铁路车次/票价（自部署 12306-MCP；T14 行程路费数据源）
# =========================
# 启动 MCP 服务（二选一）：
#   本机开发：uvx --from mcp-server-12306 mcp-12306   （SERVER_PORT=8010）
#   容器部署：docker compose --profile infra up -d rail-mcp  （自建镜像 Dockerfile.rail-mcp，映射 8010→8000）
RAIL_TOOL_ENABLE=True
# MCP Streamable HTTP 端点（query 与 rail-mcp 同容器网络时改为 http://rail-mcp:8000/mcp）
RAIL_MCP_URL=http://127.0.0.1:8010/mcp
RAIL_TIMEOUT=6
RAIL_MAX_TRAINS=5

# =========================
# 交通方式建议（2026-09-10 问题1/3：代码层确定性推荐，不让 LLM 自由裁量）
# 阈值规则 + 用户指定优先；飞机给"距离/750 + 0.5h"估算航时并标"以航司为准"
# =========================
TRANSPORT_ADVICE_ENABLE=True
# 自驾上限（公里）：不超过即推荐自驾
TRANSPORT_DRIVE_MAX_KM=300
# 铁路历时超过该小时数且距离达标 → 推荐飞机
TRANSPORT_FLIGHT_MIN_RAIL_HOURS=8
# 推荐飞机的最小距离（公里）
TRANSPORT_FLIGHT_MIN_KM=1000
# 巡航速度（km/h），用于估算航时
TRANSPORT_FLIGHT_SPEED_KMH=750

# =========================
# 住宿 / 餐饮 POI（2026-09-10 问题2：高德结构化，供行程与预算使用；仅行程分支）
# =========================
STAY_FOOD_TOOL_ENABLE=True
STAY_FOOD_MAX_HOTELS=4
STAY_FOOD_MAX_FOODS=4
STAY_HOTEL_KEYWORDS=酒店|民宿
STAY_FOOD_KEYWORDS=特色美食|地方菜
# 是否给住宿/餐饮候选标注「距景点约 X 公里」（只标注、不排序；关掉省一次高德测距）
STAY_FOOD_DISTANCE_ENABLE=True
# 距离参照景点的检索关键词（取召回 top1 作参照）
STAY_FOOD_ANCHOR_KEYWORD=旅游景区

# =========================
# 花销估算（2026-09-10 问题2：真实优先 + 缺失确定性估算并标注"预估"；门票不估）
# =========================
BUDGET_TOOL_ENABLE=True
BUDGET_DEFAULT_DAYS=2
BUDGET_MEALS_PER_DAY=3
BUDGET_MEAL_DEFAULT_PER_MEAL=60
BUDGET_HOTEL_DEFAULT_PER_NIGHT=400

# =========================
# 行程地图（2026-09-10 问题5：行程类回答在对话页内嵌高德地图，按天打点连线）
# =========================
ITINERARY_MAP_ENABLE=True
ITINERARY_MAP_MAX_POINTS=20
# 候选池未命中时的地理编码补点次数上限
ITINERARY_MAP_GEOCODE_MAX=8

# =========================
# LLM 调用缓存（意图路由 / 问题改写 / 实体抽取；含语义缓存 L2）
# T9：CACHE_BACKEND=memory（默认，进程内零依赖）/ redis（多进程·重启后全局共享）
#    切 redis 需先起 Redis 服务（compose --profile infra 内含 rag-redis）且 REDIS_URL 可达
# =========================
LLM_CACHE_ENABLE=True
LLM_CACHE_MAXSIZE=256
LLM_CACHE_TTL_SECONDS=600
SEMANTIC_CACHE_ENABLE=True
SEMANTIC_CACHE_THRESHOLD=0.92
CACHE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0

# ==================== 移动端 BFF 网关（app/api/http/mobile_gateway.py） ====================
# T10 分层防护
MOBILE_MAX_QUERY_LEN=2000
MOBILE_INJECTION_BLOCK=True
MOBILE_RESPONSE_MASK=False
GATEWAY_AUDIT_PATH=logs/gateway_audit.jsonl
# T11 流式转发（socket 级读超时，秒）
MOBILE_STREAM_TIMEOUT_S=300
# T12 鉴权（AUTH_ENABLE=false 时 /ws/chat 不校验 token，/auth/* 返回 auth_disabled）
AUTH_ENABLE=false
# HS256 密钥，≥32 字节随机串，仅存 .env 不进镜像（开启鉴权时必填）
JWT_SECRET=
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=2592000
# 微信小程序凭据；未配置时用 AUTH_MOCK_OPENID 联调
WX_APPID=
WX_SECRET=
AUTH_MOCK_OPENID=
# T12 入站限流（拒绝式）
RATE_LIMIT_ENABLE=true
RATE_LIMIT_USER_QPS=2
RATE_LIMIT_USER_DAILY=200
RATE_LIMIT_IP_QPS=10
# 限流计数 Redis（留空回落 REDIS_URL）
RATE_LIMIT_REDIS_URL=
