            <text x='868' y='70' fontSize='16' fill='#FAF8F3' fontWeight='bold' textAnchor='middle'>5</text>
            <circle cx='1062' cy='64' r='26' fill='#B5542D' />
            <text x='1062' y='70' fontSize='16' fill='#FAF8F3' fontWeight='bold' textAnchor='middle'>6</text>
