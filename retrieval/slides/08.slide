            <text x='479' y='142' fontSize='12.5' fill='rgba(38,48,44,0.6)' textAnchor='middle'>检索相关内容</text>
            <text x='673' y='120' fontSize='16' fill='#26302C' fontWeight='bold' textAnchor='middle'>精挑细选</text>
            <text x='673' y='142' fontSize='12.5' fill='rgba(38,48,44,0.6)' textAnchor='middle'>只留最相关几段</text>
            <text x='868' y='120' fontSize='16' fill='#26302C' fontWeight='bold' textAnchor='middle'>组织回答</text>
