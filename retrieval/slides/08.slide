        <Text style={{ fontFamily: '"Source Han Serif SC","Noto Serif SC",serif', fontSize: 34, fontWeight: 'bold', color: '#26302C', marginTop: 8 }}>一条问题的一生：从提问到回答</Text>
    </Box>
    {/* B 区 · 旅程图 + 洞察 */}
    <Box style={{ flex: 1, padding: '10px 64px 74px 64px', alignItems: 'center' }}>
        <svg width={1152} height={266} viewBox='0 0 1152 266'>
