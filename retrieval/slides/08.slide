            <text x='90' y='142' fontSize='12.5' fill='rgba(38,48,44,0.6)' textAnchor='middle'>用户一句话</text>
            <text x='284' y='120' fontSize='16' fill='#26302C' fontWeight='bold' textAnchor='middle'>分诊</text>
