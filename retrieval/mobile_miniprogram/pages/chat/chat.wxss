.msg-list {
  flex: 1;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.empty-tip {
  margin-top: 180rpx;
  text-align: center;
  color: #8a94a6;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-row.assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  line-height: 1.6;
  word-break: break-word;
  white-space: pre-wrap;
}

.bubble.user {
  background: #2f6fed;
  color: #ffffff;
  border-top-right-radius: 4rpx;
}

.bubble.assistant {
  background: #ffffff;
  color: #1f2329;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.bubble.has-error {
  background: #fff1f0;
  color: #cf1322;
}

.blink {
  display: inline-block;
  margin-left: 4rpx;
  animation: blink 1s steps(1) infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background: #f2f4f8;
  border-radius: 38rpx;
  font-size: 30rpx;
}

.send-btn {
  margin-left: 16rpx;
  min-width: 132rpx;
}
