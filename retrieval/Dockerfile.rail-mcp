# ==========================================================
# rail-mcp —— 12306 铁路查询 MCP（Streamable HTTP 模式）
#
# 用途：为 query 服务的 rail_gateway 提供跨城车次/票价/历时数据源。
# 上游：drfccv/mcp-server-12306（MIT，非官方 12306 公开接口包装，只查询不订票）
#      仓库自带 Dockerfile 但**未发布官方镜像**，故此处自建（按 PyPI 包安装）。
#
# 构建：docker compose --profile infra build rail-mcp
# 单独构建：docker build -f Dockerfile.rail-mcp -t rag-rail-mcp:latest .
#
# 说明：
# - 监听 0.0.0.0:8000（容器内）；compose 中映射到主机 8010，与
#   `uvx --from mcp-server-12306 mcp-12306`（SERVER_PORT=8010）**端点口径一致**，
#   故 .env 的 RAIL_MCP_URL=http://127.0.0.1:8010/mcp 两种形态通用。
# - 无需密钥：仅访问 12306 公开查询端点，匿名 cookie 只存在于容器内内存。
# ==========================================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SERVER_HOST=0.0.0.0 \
    SERVER_PORT=8000 \
    LOG_LEVEL=INFO

# HTTP 传输依赖在部分版本位于 [http] 可选组；装了带 extra 失败则回退基础安装。
RUN pip install --no-cache-dir --upgrade pip \
    && (pip install --no-cache-dir "mcp-server-12306[http]" \
        || pip install --no-cache-dir mcp-server-12306)

EXPOSE 8000

# 健康检查：命中 /health（返回 {"status":"healthy","stations":N}）
HEALTHCHECK --interval=30s --timeout=6s --start-period=25s --retries=3 \
    CMD python -c "import os,sys,urllib.request; \
p=os.environ.get('SERVER_PORT','8000'); \
sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:'+p+'/health', timeout=5).status==200 else 1)"

# 入口：HTTP 服务器（读 SERVER_HOST/SERVER_PORT）
CMD ["mcp-12306"]
